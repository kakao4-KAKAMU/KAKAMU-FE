{
  "name": "@kakamu/client",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "prebuild": "expo prebuild",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "msw:init": "msw init ./public --save",
    "msw:sync-openapi": "node ./mocks/scripts/fetch-openapi.mjs",
    "msw:generate": "node ./mocks/scripts/generate-handlers.mts",
    "web": "expo start --web",
    "build-web": "expo export --platform web",
    "build-web-dev": "NODE_ENV=development expo export --platform web --dev",
    "build-web-production": "NODE_ENV=production expo export --platform web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.2.2",
    "@kakamu/api": "workspace:*",
    "@kakamu/i18n": "workspace:*",
    "@kakamu/query": "workspace:*",
    "@kakamu/schema": "workspace:*",
    "@kakamu/store": "workspace:*",
    "@kakamu/types": "workspace:*",
    "@kakamu/ui": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/auth": "^24.0.0",
    "@react-native-seoul/kakao-login": "^5.4.2",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "~7.11.0",
    "culori": "^4.0.2",
    "eventemitter3": "^5.0.4",
    "expo": "~55.0.23",
    "expo-blur": "^56.0.3",
    "expo-build-properties": "^55.0.13",
    "expo-constants": "~55.0.16",
    "expo-font": "~55.0.7",
    "expo-image-picker": "~55.0.8",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.15",
    "expo-router": "~55.0.14",
    "expo-secure-store": "~55.0.8",
    "expo-splash-screen": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-web-browser": "~55.0.15",
    "firebase": "^12.10.0",
    "nativewind": "preview",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.75.0",
    "react-native": "0.83.6",
    "react-native-css": "^3.0.7",
    "react-native-gesture-handler": "^2.31.2",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.7.4",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@msw/source": "^0.6.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/culori": "^4.0.1",
    "@types/react": "~19.2.14",
    "@types/react-native-web": "^0.19.2",
    "fast-text-encoding": "^1.0.6",
    "msw": "^2.14.6",
    "postcss": "^8.5.6",
    "react-native-url-polyfill": "^3.0.0",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.9.2"
