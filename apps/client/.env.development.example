# Local development — copy to `.env.development` and fill in secrets.
# MSW mock: set EXPO_PUBLIC_USE_MSW=true to intercept backend REST API (Web + iOS/Android).
# 초기화는 app/_layout.tsx(useMswBootstrap)에서 수행 — 별도 index.js bootstrap 불필요.

EXPO_PUBLIC_USE_MSW=true

# Must match the base URL used when running `pnpm msw:generate`.
EXPO_PUBLIC_BACKEND_API_URL=http://dev.filma.cloud/api
EXPO_PUBLIC_UPLOAD_API_URL=http://dev.filma.cloud/upload
EXPO_PUBLIC_CHAT_API_URL=http://dev.filma.cloud/api
EXPO_PUBLIC_IMAGE_API_URL=http://dev.filma.cloud/images

# Firebase (Web)
EXPO_PUBLIC_FIREBASE_WEB_API_KEY=
EXPO_PUBLIC_FIREBASE_WEB_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_WEB_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_WEB_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_WEB_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_WEB_APP_ID=
EXPO_PUBLIC_FIREBASE_WEB_MEASUREMENT_ID=

# Kakao
EXPO_PUBLIC_KAKAO_APP_KEY=
EXPO_PUBLIC_KAKAO_JS_KEY=

# Sentry (optional)
EXPO_PUBLIC_SENTRY_DNS=
